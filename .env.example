# GEMINI_API_KEY: Required for Google Gemini AI resume analysis.
# Obtain a key from Google AI Studio or configure it via Secrets in the runtime environment.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GEMINI_MODEL: Optional override for the Gemini model name (defaults to gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: Optional application URL in hosted environments.
APP_URL="http://localhost:3000"
